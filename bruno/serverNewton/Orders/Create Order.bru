meta {
  name: Create Order
  type: http
  seq: 1
  tags: [
    orders
  ]
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  content-type: application/json
}

body {
  {
    "items": [
      {
        "productId": 1,
        "quantity": 1
      },
      {
        "productId": 2,
        "quantity": 2
      }
    ]
  }
}

script:post-response {
  bru.setVar("orderId", res.body.id);
}

tests {
  test("Status 201", function() {
    expect(res.status).to.equal(201);
  });

  test("Deve conter os itens", function() {
    expect(res.body.items).to.be.an('array');
    expect(res.body.items.length).to.equal(2);
  });

  test("Deve calcular o total", function() {
    expect(res.body.total).to.be.a('number');
  });
}

docs {
  Cria um pedido para o usuário autenticado.
  Informe os itens com "productId" (ids de produtos existentes) e "quantity".
  O preço é buscado do produto quando não informado; o total é calculado automaticamente.
}
