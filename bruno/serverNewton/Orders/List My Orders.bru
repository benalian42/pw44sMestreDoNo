meta {
  name: List My Orders
  type: http
  seq: 2
  tags: [
    orders
  ]
}

get {
  url: {{baseUrl}}/orders
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Deve retornar uma lista", function() {
    expect(res.body).to.be.an('array');
  });
}

docs {
  Lista os pedidos do usuário autenticado.
}
